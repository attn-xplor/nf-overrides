{
  "manifest_version": 3,
  "name": "NF Overrides",
  "author": "attn-xplor",
  "homepage_url": "https://github.com/attn-xplor/nf-overrides",
  "version": "1.0",

  "description": "A lightweight tool for making microfrontend substitutions.",

  "icons": {
    "128": "icon.svg"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_icon": "icon.svg",
    "default_title": "NF Overrides",
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "{35c1648c-deae-4492-bcb3-a3265da98927}"
    }
  }
}
